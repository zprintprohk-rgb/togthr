# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# cloudflare
.cloudflare
.cf
.well-known

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# locale CI artifacts (machine-generated)
locale-report.json

# ── Local debug artifacts (cleanup 2026-06-04) ──
# npm / build / dev logs
*.log
!scripts/**/*.log
!*.log.example

# CI gate reports (machine-generated, one-off)
gate*.txt

# Locale-fix preview diff (transient; regenerate via fix-locale-pollution.js)
locale-fix-preview.diff

# Dev server page snapshots (debug only)
pricing-*.html

# Old / refactored source backups (delete after refactor verified)
*_old.ts

# MCP / Matrix image-gen request payloads (transient, never commit)
*-batch-*.json
ip-*.json
pet-*.json
anim-*.json
occupation-*.json
locale-report.json
.translation-baseline.json
upload-translations.json
components.json

# ── Local dev artifacts (never commit) ──
# Dev server background logs
dev-bg*.err
dev-bg*.log
dev-bg*.out
# Worker transient scripts
.gen-*.js
# Window-generated text files (Chinese names)
新建文本文档/
新建文本文档.*

# ── Local agent runtime data (never commit) ──
# hermes (C:\Users\Administrator\.hermes\) + mavis + autoclaw + opencode
# all run locally and write their own state dirs into the workspace
.hermes/
.mavis/
.openclaw/
.opencode/
.openclaw-attachments/

# ── Agent identity / memory docs (project handover lives outside repo) ──
HEARTBEAT.md
IDENTITY.md
SOUL.md
TOOLS.md
USER.md

# ── Handover dir (.harness/handover/ is project memory, transient) ──
.harness/handover/

# ── Transient scripts / decision artifacts (one-off, never part of product) ──
count-we2.cjs
fix-we2-brand.cjs
decision-i18n-7-locales.json
P新建文件夹/
docs/fusion-v3/opc-workflows/
docs/legacy-planning/
